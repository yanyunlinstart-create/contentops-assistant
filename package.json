{
  "name": "contentops-assistant",
  "version": "1.2.0",
  "private": true,
  "description": "A local workflow assistant for multi-account content operations and Feishu sync.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "backend:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-backend.ps1",
    "backend:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-backend.ps1 -Restart",
    "backend:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/status-backend.ps1",
    "backend:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-backend.ps1",
    "test": "node contentRules.test.js && node postPublishFollowup.test.js"
  },
  "dependencies": {},
  "engines": {
    "node": ">=18"
  }
}
